<?xml version="1.0" encoding="utf-8"?>
<!--
  qingjian 输入法的 IBus 组件描述。
  <name> 子元素是组件的 DBus 名：daemon 靠它把引擎进程（request_name）
  与本组件关联起来，必须与 main.c 里 request 的名字一致。
  安装为 /usr/share/ibus/component/qingjian.xml（registry 只认 .xml 后缀）。
-->
<component>
  <name>org.qingjian.IBus.Qingjian</name>
  <description>Qingjian pinyin IME for IBus (learn-input build)</description>
  <exec>@bindir@/ibus-engine-qingjian</exec>
  <version>@version@</version>
  <author>learn-input</author>
  <license>GPL-3.0-or-later</license>
  <homepage>https://github.com/qingjian-team/qingjian</homepage>
  <textdomain>ibus-qingjian</textdomain>
  <engines>
    <engine>
      <name>qingjian</name>
      <language>zh_CN</language>
      <license>GPL-3.0-or-later</license>
      <author>learn-input</author>
      <icon>ibus-engine</icon>
      <layout>us</layout>
      <longname>Qingjian</longname>
      <description>Pinyin with English glosses (qingjian)</description>
      <symbol>青</symbol>
    </engine>
  </engines>
</component>
